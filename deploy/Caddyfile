# HTTPS reverse proxy for the Employee Leave Management System.
# Certificates are issued and renewed automatically by Caddy (Let's Encrypt).
#
#   https://ems.saibende.in      -> frontend (nginx SPA), /api -> backend
#   https://api-ems.saibende.in  -> backend (REST API + Swagger)

ems.saibende.in {
	encode zstd gzip

	@backend path /api/* /swagger-ui* /v3/api-docs*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}

api-ems.saibende.in {
	encode zstd gzip
	reverse_proxy backend:8080
}

# Visitors using the bare Elastic IP are sent to the public hostname.
http://15.252.190.98 {
	redir https://ems.saibende.in{uri} permanent
}
